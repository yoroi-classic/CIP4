{
  "name": "@yoroi-classic/cip4-js",
  "version": "1.0.7",
  "description": "A Javascript library reference implementation for CIP4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run flowgen",
    "clean": "rm -rf ./dist",
    "eslint": "npm run lint",
    "flowgen": "flowgen ./dist/index.d.ts --no-inexact --add-flow-header -o dist/index.js.flow",
    "lint": "eslint ./index.ts ./tests/index.test.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:package": "npm run build && node ./tests/package-smoke.js",
    "test:pack": "npm run build && npm pack --dry-run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run test:package && npm run test:pack"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoroi-classic/CIP4.git"
  },
  "author": "Yoroi Classic Contributors",
  "homepage": "https://github.com/yoroi-classic/CIP4#readme",
  "dependencies": {
    "blake2b": "2.1.3",
    "buffer-crc32": "0.2.13",
    "fnv-plus": "1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/buffer-crc32": "0.2.4",
    "@types/node": "22.20.1",
    "eslint": "10.6.0",
    "flowgen": "1.21.0",
    "globals": "17.7.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  }
}
